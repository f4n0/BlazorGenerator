@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@implements IMainLayout

<FluentLayout Height="100dvh" OnBreakpointEnter="@(mobile => _isMobile = mobile)">
  <FluentLayoutItem Area="LayoutArea.Header" Height="45px" Style="padding: 4px 8px;">
    <div class="layout-header">
      <div class="layout-header-start">
        <FluentLayoutHamburger IconTitle="@Captions.Instance.Navigation" PanelHeader="@Captions.Instance.Navigation" />
        @if (!_isMobile)
        {
          <FluentButton IconStart="@(new Size20.LineHorizontal3())" IconOnly="true"
                        Title="@Captions.Instance.Navigation" OnClick="@(() => _navigationExpanded = !_navigationExpanded)" />
        }
        <Back />
      </div>
      <span class="layout-application-name">@BlazorEngineSettings.Instance.ApplicationName</span>
      <div class="layout-header-toolbar">
        <FluentButton OnClick="SwitchDarkLightTheme" IconOnly="true"
                      IconStart="@(new Size20.DarkTheme())" Title="@Captions.Instance.ToggleDarkTheme"
                      Tooltip="@Captions.Instance.ToggleDarkTheme" />
        @if (BlazorEngineSettings.Instance.ShowLogButton)
        {
          <Log />
        }
        @if (BlazorEngineSettings.Instance.ShowBackgroundTasks)
        {
          <BackgroundExecutorButton />
        }
        @if (BlazorEngineSettings.Instance.ShowHelpButton)
        {
          <FluentButton IconOnly="true" Title="@Captions.Instance.Help" Tooltip="@Captions.Instance.Help"
                        OnClick="@(() => HelpService?.GetHelp((Body?.Target as RouteView)!.RouteData.PageType))"
                        IconStart="@(new Size20.Question())" />
        }
      </div>
    </div>
  </FluentLayoutItem>
  <FluentLayoutItem Area="LayoutArea.Navigation" Width="@(_navigationExpanded ? "250px" : "0px")"
                    Style="@(_navigationExpanded ? null : "overflow: hidden;")">
    <NavMenu />
  </FluentLayoutItem>
  <FluentLayoutItem Area="LayoutArea.Content" Style="padding: 10px 10px 1px; min-width: 0;">
    <FluentProviders />
    <div hidden>
      <FluentMessageBarProvider Section="@BackgroundExecutor.SectionName" />
    </div>
    <ProgressBar />
    <UILock />
    <main id="blazorengine-main" class="layout-content" tabindex="-1">
      @Body
    </main>
  </FluentLayoutItem>
</FluentLayout>
