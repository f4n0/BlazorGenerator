@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inherits BlazorEngineComponentBase

<div class="@($"navmenu{(Expanded ? string.Empty : " navmenu-collapsed")}")">
  @if (Collapsible)
  {
    <div class="navmenu-header">
      <FluentButton Class="navmenu-toggle" IconStart="@(new Size20.LineHorizontal3())" IconOnly="true"
                    Appearance="ButtonAppearance.Subtle" Title="@Captions.Instance.Navigation"
                    aria-expanded="@(Expanded ? "true" : "false")" OnClick="ToggleExpandedAsync" />
    </div>
  }
  @if (_loading)
  {
    <FluentSpinner />
  }
  else
  {
    <FluentNav Width="100%" Class="navmenu-items" aria-label="@Captions.Instance.Navigation">
      <FluentNavItem Href="@NavManager.BaseUri" Match="NavLinkMatch.All" IconRest="@HomeIcon"
                     Tooltip="@Captions.Instance.Home">@Captions.Instance.Home</FluentNavItem>
      @foreach (var menu in _defaultMenus)
      {
        <FluentNavItem Href="@menu.Route" Match="NavLinkMatch.All" IconRest="@GetNavIcon(menu.Icon)"
                       Tooltip="@menu.Title">@menu.Title</FluentNavItem>
      }
      @foreach (var group in _nonDefaultGroups)
      {
        @if (group.IsSingleItem)
        {
          var menu = group.Items[0];
          <FluentNavItem Href="@menu.Route" Match="NavLinkMatch.All" IconRest="@GetNavIcon(menu.Icon)"
                         Tooltip="@menu.Title">@menu.Title</FluentNavItem>
        }
        else
        {
          <FluentNavCategory Id="@(group.GroupName.Replace(" ", ""))" Title="@group.GroupName"
                             IconRest="@(new Size16.ChevronRight())"
                             Expanded="@_expandedCategories.GetValueOrDefault(group.GroupName)"
                             ExpandedChanged="@(expanded => HandleCategoryExpandedAsync(group.GroupName, expanded))">
            @foreach (var menu in group.Items)
            {
              <FluentNavItem Href="@menu.Route" Match="NavLinkMatch.All" IconRest="@GetNavIcon(menu.Icon)"
                             Tooltip="@menu.Title">@menu.Title</FluentNavItem>
            }
          </FluentNavCategory>
        }
      }
    </FluentNav>
    @if (_footerLinks.Count > 0)
    {
      <div class="navmenu-footer">
        <FluentNav Width="100%" Class="navmenu-footer-links">
          @foreach (var footer in _footerLinks)
          {
            <FluentNavItem Href="@footer.Route" Target="@(footer.OpenInNewTab ? LinkTarget.Blank : LinkTarget.Self)"
                           IconRest="@GetNavIcon(footer.Icon)" Tooltip="@footer.Title">
              @footer.Title
            </FluentNavItem>
          }
        </FluentNav>
      </div>
    }
  }
</div>
