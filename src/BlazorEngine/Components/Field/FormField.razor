@using BlazorEngine.Enum
@typeparam T

@if (IsTableCell)
{
    @TableCell
}
else if (Field.Get != null && _isValueLoading)
{
    <FluentField LabelTemplate="@LabelContent" Required="@Field.Required"
                 LabelPosition="LabelPosition.Before" LabelWidth="20%" Style="width: 100%; margin: 0;">
        <FluentSpinner Size="SpinnerSize.Tiny" />
    </FluentField>
}
else if (Field.CustomContent != null)
{
    <FluentField LabelTemplate="@LabelContent" Required="@Field.Required" ForId="@_id"
                 Class="form-field-custom"
                 LabelPosition="LabelPosition.Before" LabelWidth="20%" Style="width: 100%; margin: 0;">
        @Field.CustomContent.Invoke(Data, Field)
    </FluentField>
}
else
{
    <div class="form-field-input" @onclick="GenericOnClick">
        @RenderField
    </div>
    @if (Field.OnLookup != null)
    {
        <FluentMenu @ref="_lookupMenu" Trigger="@(_id + "-lookup")" PersistOnItemClick="true" OpenedChanged="@(opened => _lookupOpen = opened)"
                    Style="display: contents;">
            <FluentMenuList Style="min-width: 200px;">
                @foreach (var item in Field.OnLookup.Invoke(Data) ?? new Dictionary<object, string>())
                {
                    <FluentMenuItem OnClick="@(() => SetFieldValue(item.Key))">
                        @((MarkupString)item.Value)
                    </FluentMenuItem>
                }
            </FluentMenuList>
        </FluentMenu>
    }
}

@code {
    RenderFragment? LabelContent => !EffectiveShowLabel ? null : __builder =>
    {
        <FluentText Id="@(_id + "-label-text")" Tooltip="@(Field.Tooltip ?? Field.Caption)">@Field.Caption</FluentText>
    };

    RenderFragment RenderField => __builder =>
    {
        var fieldType = Field.FieldType;
        if (fieldType is not null && TypeSwitch.TryGetValue(fieldType, out var fragment))
        {
            @fragment
        }
        else if (fieldType?.IsEnum == true)
        {
            @EnumField
        }
        else
        {
            <p>Unsupported field type: @Field.FieldType</p>
        }
    };

    RenderFragment BoolField => __builder =>
    {
        <FluentCheckbox Value="@(Convert.ToBoolean(CurrentValue))"
                        ValueChanged="@((bool value) => SetFieldValue(value))"
                        FieldEndTemplate="@DrillDownOrLookup()" @attributes="_commonAttributes" />
    };

    RenderFragment ShortField => NumberField<short>(Convert.ToInt16);
    RenderFragment UShortField => NumberField<ushort>(Convert.ToUInt16);
    RenderFragment IntField => NumberField<int>(Convert.ToInt32);
    RenderFragment UIntField => NumberField<uint>(Convert.ToUInt32);
    RenderFragment LongField => NumberField<long>(Convert.ToInt64);
    RenderFragment UlongField => NumberField<ulong>(Convert.ToUInt64);
    RenderFragment FloatField => NumberField<float>(Convert.ToSingle);
    RenderFragment DoubleField => NumberField<double>(Convert.ToDouble);
    RenderFragment DecimalField => NumberField<decimal>(Convert.ToDecimal);

    RenderFragment DateTimeField => __builder =>
    {
        <FluentDatePicker TValue="DateTime?" Value="@(Convert.ToDateTime(CurrentValue))"
                          ValueChanged="@((DateTime? value) => SetFieldValue(value))"
                          Appearance="TextInputAppearance.FilledDarker" Placeholder="@Field.PlaceHolder"
                          FieldEndTemplate="@DrillDownOrLookup()"
                          @attributes="_commonAttributes" />
    };

    RenderFragment IconField => __builder =>
    {
        <FluentField LabelTemplate="@LabelContent" Required="@Field.Required"
                     LabelPosition="LabelPosition.Before" LabelWidth="20%" Style="width: 100%; margin: 0;">
            <FluentIcon Value="@((CurrentValue as Type)?.ToFluentIcon())" />
        </FluentField>
    };

    RenderFragment ActionField => __builder =>
    {
        <FluentButton OnClick="() => Field.InternalSet(Data, null)" Appearance="ButtonAppearance.Primary"
                      Disabled="@Field.ReadOnly" Id="@_id" Style="@(_commonAttributes["style"].ToString())"
                      Class="@(_commonAttributes["class"].ToString())" Tooltip="@(Field.Tooltip ?? Field.Caption)">
            @Field.Caption
        </FluentButton>
    };

    RenderFragment EnumField => __builder =>
    {
        if (Field.FieldType is not Type enumType)
        {
            <p>Unsupported enum field type.</p>
            return;
        }
        var values = ReflectionUtilites.GetEnumNames(enumType);
        <FluentSelect TOption="string" TValue="string" Items="@values"
                      OptionText="@(value => ReflectionUtilites.GetEnumCaption(enumType, value!) ?? value ?? string.Empty)"
                      OptionValue="@(value => value)"
                      Value="@(CurrentValue is null ? null : System.Enum.GetName(enumType, CurrentValue))"
                      ValueChanged="@((string? value) => { if (value != null) SetFieldValue(System.Enum.Parse(enumType, value)); })"
                      Appearance="ListAppearance.FilledDarker" FieldEndTemplate="@DrillDownOrLookup()"
                      @attributes="_commonAttributes" />
    };

    RenderFragment TextField => __builder =>
    {
        var current = CurrentValue?.ToString();
        if (Field.Multiline)
        {
            <FluentTextArea Height="92px" Value="@current" ValueChanged="@((string? value) => SetFieldValue(value))"
                            Immediate="@Field.Immediate" Appearance="TextAreaAppearance.FilledDarker"
                            Placeholder="@Field.PlaceHolder" FieldEndTemplate="@DrillDownOrLookup()"
                            @attributes="_commonAttributes" />
        }
        else
        {
            <FluentTextInput Value="@current" ValueChanged="@((string? value) => SetFieldValue(value))"
                             TextInputType="@Field.TextInputType" Immediate="@Field.Immediate"
                             Appearance="TextInputAppearance.FilledDarker" EndTemplate="@DrillDownOrLookup()"
                             Placeholder="@Field.PlaceHolder" @attributes="_commonAttributes" />
        }
    };

    RenderFragment TableCell => __builder =>
    {
        if (Field.Get != null && _isValueLoading)
        {
            <FluentSpinner Size="SpinnerSize.Tiny" />
            return;
        }
        if (Field.CustomContent != null)
        {
            @Field.CustomContent.Invoke(Data, Field)
            return;
        }
        var current = CurrentValue;
        var link = Field.Href?.Invoke(Data) ?? string.Empty;
        var style = Field.TextStyle?.Invoke(Data) switch
        {
            TextStyle.Bold => "font-weight: bold;",
            TextStyle.Italic => "font-style: italic;",
            TextStyle.Underline => "text-decoration: underline;",
            TextStyle.Strikethrough => "text-decoration: line-through;",
            _ => string.Empty
        };
        var color = Field.Color?.Invoke(Data);
        if (color != null) style += "color: " + color.ToAttributeValue() + ";";
        if (string.IsNullOrEmpty(link))
        {
            if (Field.FieldType == typeof(Type))
            {
                <FluentIcon Value="@((current as Type)?.ToFluentIcon())" />
            }
            else if (Field.FieldType == typeof(bool))
            {
                <FluentCheckbox Value="@(Convert.ToBoolean(current))" ReadOnly="true" Style="margin: 0;" />
            }
            else
            {
                <span title="@current" style="@style">@current</span>
            }
        }
        else
        {
            <a href="@link" title="@current" style="@style">
                @if (Field.FieldType == typeof(Type))
                {
                    <FluentIcon Value="@((current as Type)?.ToFluentIcon())" />
                }
                else
                {
                    @current
                }
            </a>
        }
    };

    RenderFragment DrillDownOrLookup() => __builder =>
    {
        if (Field.OnDrillDown != null)
        {
            <FluentButton IconStart="@DrillDownIcon" Appearance="ButtonAppearance.Transparent"
                          IconOnly="true" Title="@Field.Caption" Tooltip="@Field.Caption"
                          OnClick="@(() => Field.InternalDrillDown(Data))" />
        }
        else if (Field.OnLookup != null)
        {
            <span @onclick:stopPropagation="true">
                <FluentButton Id="@(_id + "-lookup")" IconStart="@LookupIcon" Title="@Field.Caption"
                              IconOnly="true" Appearance="ButtonAppearance.Transparent" />
            </span>
        }
    };
}
