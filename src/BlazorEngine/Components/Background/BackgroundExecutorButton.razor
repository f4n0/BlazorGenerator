@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@implements IDisposable
@inject IDialogService DialogService
@inject BackgroundExecutor Executor

<div class="bg-executor-wrapper">
  <FluentBadge Content="@(Executor.NotificationCount > 0 ? (Executor.NotificationCount > 9 ? "9+" : Executor.NotificationCount.ToString()) : null)"
               Color="BadgeColor.Danger" Positioning="Positioning.AboveEnd" Class="badge"
               Style="@(Executor.NotificationCount == 0 ? "display: none;" : null)">
    <AnchorContent>
      <FluentButton OnClick="OpenNotificationCenterAsync" IconOnly="true"
                    Title="Notification center" Tooltip="Notification center" IconStart="@(new Size20.PersonRunning())" />
    </AnchorContent>
  </FluentBadge>
</div>

@code {
  protected override void OnInitialized() => Executor.OnNotificationsChanged += UpdateCount;

  private void UpdateCount() => _ = InvokeAsync(StateHasChanged);

  private async Task OpenNotificationCenterAsync()
  {
    if (Executor.PanelExecutorRef != null) return;
    var options = UIServices.CreateDialogOptions(UISizeTokens.PanelWidth, height: null, title: "Background Tasks");
    options.Footer.PrimaryAction.Visible = false;
    options.Footer.SecondaryAction.Visible = false;
    options.OnStateChange = args =>
    {
      if (args.State is DialogState.Opening or DialogState.Open) Executor.PanelExecutorRef = args.Instance;
    };
    try
    {
      await DialogService.ShowDrawerAsync<NotificationCenterPanel>(options);
    }
    finally
    {
      Executor.PanelExecutorRef = null;
    }
  }

  public void Dispose() => Executor.OnNotificationsChanged -= UpdateCount;
}
