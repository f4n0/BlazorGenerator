@typeparam T
<!--suppress CssUnresolvedCustomProperty, CssUnusedSymbol -->
@* ReSharper disable  AssignmentInsteadOfDiscard *@

<div class="GridContainer">
    <FluentKeyCode OnKeyDown="@OnKeyDownAsync" OnKeyUp="@OnKeyUpAsync" IgnoreModifier="false" tabindex="0"
                   Only="@SearchKeyCodes" StopPropagation="true" StopRepeat="true" PreventDefaultOnly="@PreventDefaultKeyCodes">
        <div class="datagrid-toolbar" style="display: flex; align-items: center; gap: 8px;">
            <FluentTextInput @bind-Value="_searchValue" AriaLabel="Search" Placeholder="@(Captions.Instance.Search + "...")"
                          Style="width: min(100%, 20rem);"
                          Autofocus="true"
                          Immediate="true" ImmediateDelay="500"
                          @bind-Value:after="HandleSearchInput" @ref="SearchBarRef">
                <StartTemplate><FluentIcon Value="@(new Icons.Regular.Size16.Search())" /></StartTemplate>
            </FluentTextInput>
            <FluentSpacer />
            @if (Selected.Count > 0)
            {
                <FluentText Style="color: var(--colorNeutralForeground3); margin-right: 8px;">
                    @Selected.Count selected
                </FluentText>
            }
            @if (ShowExportToExcel)
            {
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ExportToExcel"
                              Title="@Captions.Instance.ExportExcel"
                              IconStart="@ExportIcon">
                </FluentButton>
            }
        </div>
        @if (VisibleFields.Count > 0)
        {
            <div class="datagrid-table-wrapper">
                <FluentDataGrid Items="@FilteredData"
                                TGridItem="T"
                                ResizableColumns="true"
                                Virtualize="UseVirtualization"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                DisplayMode="DataGridDisplayMode.Table"
                                ShowHover="@true"
                                HeaderCellAsButtonWithMenu="true"
                                OnCellClick="@HandleCellClick"
                                OnRowDoubleClick="@HandleRowDoubleClick"
                                Style="min-height: 120px"
                                ItemSize="44"
                                RowSize="DataGridRowSize.Medium"
                                ResizeType="DataGridResizeType.Discrete"
                                ResizeColumnOnAllRows="false"
                                Id="table">

                    <SelectColumn TGridItem="T"
                                  SelectMode="DataGridSelectMode.Multiple"
                                  SelectFromEntireRow="false"
                                  SelectedItems="@_selectedSnapshot"
                                  SelectAll="@_selectAll"
                                  OnSelect="@HandleSelectionChange"
                                  SelectAllChanged="@HandleSelectAllChanged"
                                  Width="50px"
                                  MinWidth="50px" />

                    @if (_gridActionsCount > 0)
                    {
                        <TemplateColumn Title="&nbsp;" Align="@DataGridCellAlignment.Center" Width="30px" MinWidth="30px"
                                        Style="padding: 0 !important;">
                            <ChildContent>
                                <FluentButton Id="@GetRowId(context!)"
                                              Appearance="ButtonAppearance.Outline"
                                              IconOnly="true"
                                              Title="@Captions.Instance.MoreActions"
                                              IconEnd="@MoreVerticalIcon" />

                                <div class="datagrid-context-menu">
                                    <FluentMenu Trigger="@GetRowId(context!)">
                                      <FluentMenuList>
                                        @foreach (var a in GridActions ?? [])
                                        {
                                            <FluentMenuItem Label="@a.Attribute.Caption" OnClick="@(_ => InvokeGridAction(a.Method, context!))"
                                                            IconStart="@(a.Attribute.GridIcon.ToFluentIcon())" />
                                        }
                                      </FluentMenuList>
                                    </FluentMenu>
                                </div>
                            </ChildContent>
                        </TemplateColumn>
                    }

                    @foreach (var field in VisibleFields)
                    {
                        <TemplateColumn Context="data"
                                        Sortable="true"
                                        Title="@field.Caption"
                                        SortBy="GridSort<T>.ByAscending(p => field.InternalGet(p))"
                                        Filtered="@(!string.IsNullOrWhiteSpace(GetFilterValue(field.Name)))"
                                        Width="auto">
                            <ChildContent>
                                <FormField IsTableCell="true" Data="data" Field="field" T="T" />
                            </ChildContent>
                            <ColumnOptions>
                                <div class="search-box">
                                    @{
                                        GetFilterValue(field.Name);
                                        var name = field.Name;
                                    }
                                    <FluentTextInput Autofocus="true" Immediate="true"
                                                     Value="@FieldFilters[name]"
                                                     ValueChanged="@(value => HandleFilter(value, field))"
                                                     Placeholder="@field.Caption">
                                        <StartTemplate><FluentIcon Value="@(new Icons.Regular.Size16.Search())" /></StartTemplate>
                                    </FluentTextInput>
                                </div>
                            </ColumnOptions>
                        </TemplateColumn>
                    }

                    @if (PermissionSet!.Modify || PermissionSet!.Delete || PermissionSet!.Insert)
                    {
                        <TemplateColumn Title="Actions" Align="@DataGridCellAlignment.Center" Width="110px">
                            <ChildContent>
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4px">
                                    @if (PermissionSet!.Modify)
                                    {
                                        <FluentButton IconEnd="@EditIcon" Appearance="ButtonAppearance.Subtle"
                                                      OnClick="@(() => EditAsync(context))" Title="Edit" />
                                    }
                                    @if (PermissionSet!.Delete)
                                    {
                                        <FluentButton IconEnd="@DeleteIcon" Appearance="ButtonAppearance.Subtle"
                                                      OnClick="@(() => HandleDelete(context))" Title="Delete" />
                                    }
                                </FluentStack>
                            </ChildContent>
                            <HeaderCellItemTemplate>
                                @if (PermissionSet!.Insert)
                                {
                                    <div class="datagrid-header-add-btn">
                                        <FluentButton IconEnd="@AddIcon" Appearance="ButtonAppearance.Primary" OnClick="@(() => NewItem())"
                                                      Title="Add new" />
                                    </div>
                                }
                            </HeaderCellItemTemplate>
                        </TemplateColumn>
                    }
                </FluentDataGrid>
            </div>
        }
        else
        {
            <div class="datagrid-loading">
                <FluentSpinner />
            </div>
        }
    </FluentKeyCode>
</div>
