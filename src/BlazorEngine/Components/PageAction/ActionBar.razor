@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular

<div class="actionbar-wrapper">
  <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Class="actionbar" role="toolbar">
    <FluentText Weight="TextWeight.Bold" Size="TextSize.Size500" Class="actionbar-title">
      @((Context as BlazorEngineComponentBase)?.Title)
    </FluentText>
    <FluentOverflow TItem="ActionGroup" Items="@_overflowGroups" Class="actionbar-overflow">
      <ItemTemplate Context="group">
        <div class="actionbar-item">
          @if (group.Actions.Count == 1)
          {
            var action = group.Actions[0];
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          OnClick="@(() => InvokeActionAsync(action.Method))"
                          IconStart="@(action.Attribute.Icon.ToFluentIcon())">
              @action.Attribute.Caption
            </FluentButton>
          }
          else
          {
            var first = group.Actions[0];
            <SplitButton Title="@first.Attribute.Caption" Icon="@first.Attribute.Icon.ToFluentIcon()"
                         Appearance="ButtonAppearance.Subtle" OnClick="@(() => InvokeActionAsync(first.Method))">
              @foreach (var action in group.Actions)
              {
                <SplitButtonItem OnClick="@(() => InvokeActionAsync(action.Method))"
                                 Label="@action.Attribute.Caption" IconStart="@action.Attribute.Icon.ToFluentIcon()" />
              }
            </SplitButton>
          }
        </div>
      </ItemTemplate>
      <MoreTemplate>
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => OpenMore = !OpenMore)"
                      IconEnd="@(new Size16.MoreHorizontal())" IconOnly="true" Title="@Captions.Instance.MoreActions" />
      </MoreTemplate>
      <OverflowTemplate>
        <FluentPopover AnchorId="@context.IdMoreButton" @bind-Opened="OpenMore" Style="width: 320px;">
          <FluentStack Orientation="Orientation.Vertical" VerticalGap="2px" Style="padding: 6px;">
            @foreach (var group in context.Items)
            {
              @if (group.Actions.Count > 1)
              {
                <FluentText Weight="TextWeight.Bold" Style="padding: 6px 8px 2px;">@group.Name</FluentText>
                <FluentDivider />
              }
              @foreach (var action in group.Actions)
              {
                <FluentButton Appearance="ButtonAppearance.Subtle" Style="width: 100%; justify-content: flex-start;"
                              OnClick="@(() => InvokeOverflowActionAsync(action.Method))"
                              IconStart="@(action.Attribute.Icon.ToFluentIcon())">
                  @action.Attribute.Caption
                </FluentButton>
              }
            }
          </FluentStack>
        </FluentPopover>
      </OverflowTemplate>
    </FluentOverflow>
  </FluentStack>
  <FluentDivider />
</div>
