@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@typeparam T

<div class="card-fields-container">
  <FluentCard Class="card-fields-main" Appearance="CardAppearance.Filled" Shadow="CardShadow.None">
    <FluentGrid Id="FieldGroup" Spacing="3" Class="card-fields-grid">
      @if (VisibleFields.Any(o => o.Additional))
      {
        <FluentGridItem Justify="JustifyContent.FlexEnd" Xs="12" Style="padding: 0;">
          <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                        IconEnd="@(ShowAdditional ? new Size16.ChevronUp() : new Size16.ChevronDown())"
                        OnClick="ShowAdditionalFields">
            @(ShowAdditional ? "Show less" : "Show more")
          </FluentButton>
        </FluentGridItem>
      }

      @foreach (var context in _groupedFields[string.Empty])
      {
        var attrs = new Dictionary<string, object>();
        if (context.Additional)
        {
          attrs.Add("Style", $"display: {(ShowAdditional ? "inherit" : "none")}");
        }

        <FluentGridItem Xs="12" Md="GridSize" AdditionalAttributes="attrs">
          <FormField Data="Data" Field="context" T="T"/>
        </FluentGridItem>
      }
    </FluentGrid>
  </FluentCard>

  @if (_groups.Any())
  {
    <FluentAccordion Class="card-fields-groups">
      @foreach (var group in _groups)
      {
        <FluentAccordionItem Expanded="true">
          <HeaderTemplate>
            <FluentText Weight="TextWeight.Semibold">@group</FluentText>
          </HeaderTemplate>
          <ChildContent>
            <FluentCard Class="card-fields-group-card" Appearance="CardAppearance.Filled" Shadow="CardShadow.None">
              <FluentGrid Spacing="3" Class="card-fields-grid">
                @foreach (var context in _groupedFields[group])
                {
                  <FluentGridItem Xs="12" Md="GridSize">
                    <FormField Data="Data" Field="context" T="T"/>
                  </FluentGridItem>
                }
              </FluentGrid>
            </FluentCard>
          </ChildContent>
        </FluentAccordionItem>
      }
    </FluentAccordion>
  }

  @if (ShowButtons)
  {
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Class="card-fields-actions">
      @if ((PermissionSet?.Modify ?? false) || (PermissionSet?.Insert ?? false))
      {
        <FluentButton OnClick="@(() => HandleSave(Data!))"
                      Appearance="ButtonAppearance.Primary"
                      IconStart="@(new Size16.Save())">
          @Captions.Instance.Save
        </FluentButton>
      }
      @if (PermissionSet?.Delete ?? false)
      {
        <FluentButton OnClick="@(() => HandleDiscard(Data!))"
                      Appearance="ButtonAppearance.Outline"
                      IconStart="@(new Size16.Dismiss())">
          @Captions.Instance.Cancel
        </FluentButton>
      }
    </FluentStack>
  }
</div>
