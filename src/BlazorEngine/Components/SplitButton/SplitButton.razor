@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
<div>
  <CascadingValue Value="this" IsFixed="true">
    <FluentStack HorizontalGap="0px" Style="min-width: 100px; max-width:300px;">
      <FluentButton Appearance="@Appearance" OnClick="@OnClick"
                    Style="border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important;"
                    IconStart="Icon">
        @Title
      </FluentButton>
      <FluentButton Id="@_id"
                    Style="border-top-left-radius: 0 !important; border-bottom-left-radius: 0 !important;"
                    IconEnd="@(new Size16.ChevronDown())"
                    Appearance="@Appearance"
                    IconOnly="true" Title="@Title"/>


      <FluentMenu Trigger="@_id" Style="display: contents;">
        <FluentMenuList Style="min-width: 100px; max-width: 300px;">@ChildContent</FluentMenuList>
      </FluentMenu>
    </FluentStack>
  </CascadingValue>
</div>
