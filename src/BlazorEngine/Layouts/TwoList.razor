@typeparam TFirstList
@typeparam TSecondList
@inherits BlazorEngineComponentBase
@{
  var pageActions = CreatePageActions();
  var firstGridActions = CreateFirstListGridActions();
  var secondGridActions = CreateSecondListGridActions();
}
<PageTitle>@Title</PageTitle>
<div class="two-list-root">
  <div class="two-list-header">

    @if (ShowActions)
    {
      <ActionBar Context="this" PageActions="pageActions"/>
    }

  </div>
  <div class="two-list-content contentblock">
    <FluentMultiSplitter Orientation="Orientation.Horizontal">
      <FluentMultiSplitterPane Size="50%">
        <ListDataGrid T="TFirstList"
                      Context="this"
                      Data="FirstListContent"
                      VisibleFields="FirstListVisibleFields"
                      OnDiscard="data => OnDelete(data)"
                      OnSave="data => OnSave(data)"
                      PermissionSet="permissionSet"
                      @bind-Selected="FirstListSelected"
                      ShowButtons="ShowButtons"
                      GridActions="firstGridActions"
                      ShowExportToExcel="ShowExportToExcelFirstList"
                      EditFormType="FirstListEditFormType"/>
      </FluentMultiSplitterPane>
      <FluentMultiSplitterPane>
        <ListDataGrid T="TSecondList"
                      Context="this"
                      Data="SecondListContent"
                      VisibleFields="SecondListVisibleFields"
                      OnDiscard="data => OnDelete(data)"
                      OnSave="data => OnSave(data)"
                      PermissionSet="permissionSet"
                      @bind-Selected="SecondListSelected"
                      ShowButtons="ShowButtons"
                      GridActions="secondGridActions"
                      ShowExportToExcel="ShowExportToExcelSecondList"
                      EditFormType="SecondListEditFormType"/>
      </FluentMultiSplitterPane>
    </FluentMultiSplitter>
  </div>

</div>
